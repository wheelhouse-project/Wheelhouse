// Tag parsing for the engine's stdout contract.
//
// This file is included into the [Code] section of Wheelhouse-Setup.iss, so
// everything in it is Pascal Script and takes Pascal comments -- a ';' comment
// here is read as code and fails the compile with "'BEGIN' expected".
//
// install-wheelhouse.ps1 writes one tagged line at a time to the real stdout
// stream (PROGRESS, HEARTBEAT, FAILURE, FAILHINT), and the wizard reads them
// in EngineLog. Both sides have to agree on where the tag ends and its text
// begins. That agreement used to be four hand-counted Copy offsets inside
// EngineLog, one per tag; a single character wrong in any of them compiles
// without complaint and shows the user a blank dialog at the worst moment.
// It lives here instead, computed from the tag itself, and the test harness in
// scripts/release/tests/test_wizard.py includes this same file so the parsing
// is exercised for real rather than only read (wh-wizard-failure-guidance.1.2).

const
  { Longest tag text the wizard will put on screen. The hand-written failure
    messages are a line or two, but the unexpected-error path passes a .NET
    exception message through, and the engine folds any newlines in it to
    spaces -- so what arrives can be one line of any length. A message box has
    no scrollbar and grows to fit its text, so a long enough line pushes the
    buttons off a small screen and the user cannot act on the dialog at all.
    Every line is written to the setup log in full before it is parsed, so
    nothing is lost by shortening what is shown (wh-wizard-failure-guidance.2.3). }
  MAX_TAG_TEXT = 400;

function ShortenTagText(const S: string): string;
begin
  if Length(S) > MAX_TAG_TEXT then
    Result := Copy(S, 1, MAX_TAG_TEXT) + ' [...] (the rest of this message is in the setup log)'
  else
    Result := S;
end;

function TagPayload(const Line, Tag: string; var Payload: string): Boolean;
begin
  { A tag is its name followed by a space, then the text. EngineLog trims each
    line before matching, so a tag whose text is empty arrives as the bare name
    with the separating space already gone -- that still counts as the tag,
    with no text. Matching only the space form would drop such a line entirely:
    the wizard would never learn the install had failed and would leave the
    previous failure's advice on screen (wh-wizard-failure-guidance.1.3).
    Requiring the space or the end of the line is what keeps a longer word
    starting with the tag name, such as FAILUREXYZ, from matching. }
  Result := True;
  if Copy(Line, 1, Length(Tag) + 1) = Tag + ' ' then
    Payload := ShortenTagText(Trim(Copy(Line, Length(Tag) + 2, Length(Line))))
  else if Line = Tag then
    Payload := ''
  else
    Result := False;
end;
